      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(http_requests_total[5m])) by (handler)", "legendFormat": "{{handler}}" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Requêtes par statut",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
